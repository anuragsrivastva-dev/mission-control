# Copy to .env and adjust as needed.
# docker-compose.yml also sets these for a zero-config local run.

# Commander
PORT=8080
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
MYSQL_DSN=mission:mission@tcp(mysql:3306)/mission_control?parseTime=true&multiStatements=true
SOLDIER_SHARED_SECRET=change-me-soldier-secret
TOKEN_TTL_SECONDS=30
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5

# Soldier
COMMANDER_URL=http://commander:8080
# SOLDIER_ID=           # optional; defaults to soldier-<hostname>
WORKER_POOL_SIZE=4
MISSION_MIN_DELAY_SECONDS=5
MISSION_MAX_DELAY_SECONDS=15
TOKEN_REFRESH_SKEW_SECONDS=5

# MySQL (compose)
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=mission_control
MYSQL_USER=mission
MYSQL_PASSWORD=mission
